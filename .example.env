# ============================================
# AI Maestro - Environment Configuration
# ============================================
#
# Copy this file to .env.local and uncomment only what you need:
#   cp .example.env .env.local
#
# .env.local is gitignored. THIS file is COMMITTED — never put a real
# secret in it.
#
# ---- HOW THESE INTERACT WITH THE DASHBOARD ----------------------------
#
# EVERY LINE IS COMMENTED OUT ON PURPOSE. Leave it that way unless you
# specifically want to override something.
#
# Each variable is an INDEPENDENT override of one setting. Uncommenting a
# single line overrides ONLY that setting — every other value keeps coming
# from the dashboard / the built-in default. Uncommenting AIM_SMTP_HOST,
# for example, changes the relay host and nothing else: the same account,
# credentials and port stay in effect.
#
# AN UNCOMMENTED LINE WINS FOR THE WHOLE SESSION. The environment is read
# once, when the server starts, and it takes precedence over the value
# configured in the dashboard. So while a line is uncommented, changing
# that setting in the Settings panel HAS NO EFFECT — the dashboard will
# appear to accept your change while the server keeps using this file's
# value. Re-comment the line and restart to hand control back to the UI.
#
# Changing anything here requires a restart to take effect:
#   pm2 restart ai-maestro
#
# ---- ACCURACY ---------------------------------------------------------
#
# Every default below was read from the source, not assumed. If you add a
# variable here, verify the code actually reads it — this file previously
# documented four knobs (WS_*, TERMINAL_*) that nothing ever read, so
# setting them did nothing and sent people debugging the wrong layer.

# ============================================
# Network Configuration
# ============================================

# HOSTNAME - Primary bind address.
# Default: 127.0.0.1 (localhost only)                      [server.mjs]
#
# You almost certainly should NOT set this. Remote access is NOT enabled
# by binding a wider address — it is automatic when Tailscale is present:
#
#   Tailscale installed + HOSTNAME localhost  -> binds dual-stack (::) and
#     filters at the TCP level to Tailscale ranges only (100.64.0.0/10,
#     fd7a:115c:a1e0::/48) plus loopback. This is the remote-access path.
#   No Tailscale + HOSTNAME non-localhost     -> REFUSED. The server logs
#     "[SECURITY] non-localhost bind requested but Tailscale is not
#     available" and falls back to localhost.
#
# LAN and public IPs are dropped before any HTTP/WebSocket handling, so
# HOSTNAME=0.0.0.0 does NOT grant LAN access — it only trips the failsafe.
# HOSTNAME=127.0.0.1

# PORT - Server port
# Default: 23000
# PORT=23000

# ============================================
# Server Mode
# ============================================

# MAESTRO_MODE - full (Next.js UI + API) or headless (API only, no UI).
# Headless starts ~5x faster and uses ~1/3 the memory; use it for worker
# nodes that only need the API surface.
# Default: full
# MAESTRO_MODE=full

# ============================================
# Node.js Environment
# ============================================

# NODE_ENV - development | production
# Default: development
# NODE_ENV=development

# ============================================
# Session Logging
# ============================================

# ENABLE_LOGGING - Global master switch for terminal session logging.
# When "true", session content is written to logs/{sessionName}.txt
# (gitignored) and a per-session toggle appears in the terminal header.
# Any other value (including unset) disables logging, and the per-session
# toggles then have no effect.
# Default: false (only the exact string "true" enables it)
# ENABLE_LOGGING=true

# ============================================
# AMP Push Notifications
# ============================================

# NOTIFICATIONS_ENABLED - Push a tmux notification when a message is
# routed to a local agent. Only the exact string "false" disables it.
# Default: true
# NOTIFICATIONS_ENABLED=false

# NOTIFICATION_FORMAT - Template for the pushed line. Placeholders
# {from} and {subject} are substituted.
# Default: [MESSAGE] From: {from} - {subject} - check your inbox
# NOTIFICATION_FORMAT=[MESSAGE] From: {from} - {subject} - check your inbox

# NOTIFICATION_SKIP_TYPES - Comma-separated message types to NOT notify on.
# Default: system,heartbeat
# NOTIFICATION_SKIP_TYPES=system,heartbeat

# ============================================
# AMP Messaging
# ============================================

# AIMAESTRO_ORG - Tenant used when registering an agent's AMP identity
# (the "org" in alice@org.local).
# Default: default
# AIMAESTRO_ORG=default

# AMP_RELAY_TTL_DAYS - How long an undelivered relayed message is retained
# for an offline agent to poll.
# Default: 7 (per the AMP protocol spec)
# AMP_RELAY_TTL_DAYS=7

# ============================================
# Email Recovery Relay (SMTP) — OPTIONAL
# ============================================
#
# Only needed to send password-reset codes by email. The normal path is to
# configure this in the UI (Settings -> Hosts -> Recovery Email), which
# derives the SMTP settings from your email domain and stores the password
# in the OS keychain.
#
# Each variable below overrides ONLY its own field of that stored relay.
# Set AIM_SMTP_HOST alone and you get the same account and credentials on a
# different host. You do NOT have to supply the whole set.
#
# The MERGED result must still be complete (host + port + user + pass) for
# email to work at all. So if you have no relay configured in the UI, a lone
# override is not enough on its own — the channel stays off and recovery
# falls back to the console, rather than half-enabling a relay that would
# fail at send time.
#
# NEVER put a real AIM_SMTP_PASS in THIS file — it is committed. Put it in
# .env.local (gitignored), or prefer the UI so the secret lands in the
# keychain rather than in a file.
#
# AIM_SMTP_HOST=smtp.example.com
# AIM_SMTP_PORT=587
# AIM_SMTP_USER=you@example.com
# AIM_SMTP_PASS=

# AIM_SMTP_FROM - From address.  Default: the effective user
# AIM_SMTP_FROM=you@example.com

# AIM_SMTP_SECURE - Implicit TLS on connect. Must be exactly "true"/"false".
# Default: the stored relay's setting; if you override AIM_SMTP_PORT it is
# re-derived from the new port (465 = implicit TLS, anything else STARTTLS),
# so an overridden port never inherits a TLS mode that cannot connect.
# AIM_SMTP_SECURE=true

# AIM_SMTP_CRED_BACKEND - Set to "file" to force a 0600 JSON file under
# ~/.aimaestro instead of the OS keychain (for CI / non-macOS).
# Default: keychain where available
# AIM_SMTP_CRED_BACKEND=file

# ============================================
# Optional Integrations
# ============================================

# GITHUB_TOKEN - Raises the GitHub API rate limit when fetching plugins /
# marketplaces. Read-only public access needs no token; unset = anonymous.
# Default: unset
# GITHUB_TOKEN=

# ANTHROPIC_API_KEY - Enables LLM summarization in the Cerebellum voice
# subsystem. Without it, voice falls back to plain ANSI stripping.
# Default: unset
# ANTHROPIC_API_KEY=

# ============================================
# Advanced — watchdogs and boot behavior
# ============================================
#
# These are tuning knobs, not everyday configuration. Defaults are correct
# for normal operation.

# AIM_INVARIANTS_WATCHDOG_INTERVAL_MS - Period of the agent-workdir
# invariants sweep (re-applies the shipped aimaestro-*.md rules, etc.).
# Default: 300000 (5 min).  0 disables.
# AIM_INVARIANTS_WATCHDOG_INTERVAL_MS=300000

# AIM_SETTINGS_ENFORCER_INTERVAL_MS - Period of the ~/.claude/settings.json
# runtime-env enforcer (restores the required Claude Code env keys on drift).
# Default: 300000 (5 min).  0 disables.
# AIM_SETTINGS_ENFORCER_INTERVAL_MS=300000

# AIM_DISABLE_BOOT_RESTORE - Set to 1 to skip restoring persisted agent
# sessions at server boot.
# Default: unset (boot restore enabled)
# AIM_DISABLE_BOOT_RESTORE=1

# ============================================
# Tests and Scenarios — the governance password
# ============================================
#
# The UI scenario tests need the governance password to drive sudo-gated
# operations (delete agent, delete team, change title, ...).
#
# It is deliberately NOT listed as a key in this file. This file is
# committed, and an empty password-shaped key in a committed file is what
# caused a live credential to be published once already.
#
# Define it in .env.local (gitignored), which the scenario harness reads:
#
#   AIM_GOVERNANCE_PASSWORD=<your governance password>
#
# Scenario files reference the variable by NAME only ("$AIM_GOVERNANCE_PASSWORD"),
# never its value, and the dev-browser helpers resolve it themselves so the
# secret travels env -> shell -> script stdin without passing through a model.
# See tests/scenarios/SCENARIOS_TESTS_RULES.md (Rule 12).

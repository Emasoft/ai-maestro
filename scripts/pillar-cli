#!/bin/bash
#
# The ONE launcher behind every pillar CLI. Installed to ~/.local/bin/ once per pillar,
# under the name of the corpus it queries — `memgrep`, `trddgrep`, `prrdgrep`, `specgrep`
# (USER naming law, 2026-07-30: `<document type>grep`). It dispatches on the name it was
# invoked as, so there is ONE implementation and N entry points, not N scripts.
# TRDD-217AYEOT.
#
# WHY THIS FILE HAS NO `.sh` EXTENSION — it is deliberate, do not "fix" it.
# install-messaging.sh copies `scripts/amp-*.sh` and then the rest of `scripts/*.sh`.
# A `pillar-cli.sh` would therefore ALSO land in ~/.local/bin as `pillar-cli.sh`, giving
# the same tool a second, wrong, discoverable name — exactly the confusion the USER
# forbade ("don't create multiple versions of the tools"). Being invisible to that glob
# is what makes the explicit install step below the ONLY way this reaches a bin dir.
#
# WHY IT MUST BE BASH, NOT SH/ZSH: it sources scripts/pin-node.sh, which is bash
# (BASH_SOURCE, `local -a`). Sourced from zsh its version gate DEGRADES SILENTLY and
# hands back an out-of-range Node — measured 2026-07-30: bash → v22.23.1 (correct),
# zsh → v26.5.0, past the `engines: <26` cap that node-pty and better-sqlite3 need.
set -euo pipefail

TOOL="$(basename "$0")"
if [ "$TOOL" = "pillar-cli" ]; then
  echo "pillar-cli: invoke me under a pillar name — trddgrep, prrdgrep or specgrep." >&2
  echo "pillar-cli: (install-messaging.sh copies this file to ~/.local/bin under each.)" >&2
  exit 2
fi

# ── 1. Find the ai-maestro install that owns the implementation.
#
# NEVER hardcode ~/ai-maestro: when ai-maestro ships as a package there is no such
# directory (CLAUDE.md, install-location independence). Only ~/.aimaestro and ~/agents
# stay at fixed home paths.
#
# Two ways, in order, and the first is a TEST rather than a guess: if this script is
# sitting in an ai-maestro tree that carries the implementation, use that tree — which is
# what makes the in-repo `scripts/pillar-cli` and the installed copy behave identically.
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/aimaestro/install-root"
ROOT=""

if [ -f "$SELF_DIR/../scripts/$TOOL.mjs" ]; then
  ROOT="$(cd "$SELF_DIR/.." && pwd)"
elif [ -r "$ROOT_FILE" ]; then
  read -r ROOT < "$ROOT_FILE" || true
  if [ -z "$ROOT" ] || [ ! -f "$ROOT/scripts/$TOOL.mjs" ]; then
    echo "$TOOL: the recorded ai-maestro install is stale or incomplete." >&2
    echo "$TOOL:   recorded: ${ROOT:-<empty>} (from $ROOT_FILE)" >&2
    echo "$TOOL:   expected: \$ROOT/scripts/$TOOL.mjs" >&2
    echo "$TOOL: re-run install-messaging.sh from the ai-maestro checkout." >&2
    exit 2
  fi
else
  echo "$TOOL: no ai-maestro install recorded at $ROOT_FILE." >&2
  echo "$TOOL: run install-messaging.sh from an ai-maestro checkout first." >&2
  exit 2
fi

# ── 2. Node 22. Reuse the repo's selector; never re-derive it.
#
# pin-node.sh parses `engines` from package.json and version-CHECKS each candidate binary
# (some brew node@N kegs are mislabelled and actually report v26), then prepends the
# winner to PATH. It FAILS rather than falling back, which is the behaviour we want: a
# wrong Node does not degrade the pillar tools, it breaks their native index outright.
# shellcheck source=/dev/null
if ! source "$ROOT/scripts/pin-node.sh"; then
  echo "$TOOL: no Node matching ai-maestro's engines range is installed (see above)." >&2
  exit 2
fi

# ── 3. Reach the TypeScript libs from a FOREIGN cwd.
#
# Both halves are required, and each was established by measurement (2026-07-30):
#   · `--import tsx` resolves the bare specifier against the CWD, so from a caller's
#     project it dies with "Cannot find package 'tsx'". An ABSOLUTE path is immune.
#   · tsx discovers tsconfig.json from the CWD too, so without TSX_TSCONFIG_PATH the
#     `@/lib/...` aliases inside lib/*.ts go unresolved (MODULE_NOT_FOUND, raised from
#     lib/trdd-graph.ts). Pinning the install's tsconfig fixes the alias map.
# The cwd deliberately stays the CALLER's, because that is what makes `--design-dir`
# default correctly, environment detection see the caller's project, and printed paths
# read relative to where the human actually is.
TSX_ENTRY="$ROOT/node_modules/tsx/dist/loader.mjs"
if [ ! -f "$TSX_ENTRY" ]; then
  # tsx's "." export has moved before; ask node rather than hardcoding a second guess.
  TSX_ENTRY="$(cd "$ROOT" && node -e 'console.log(require.resolve("tsx"))' 2>/dev/null || true)"
fi
if [ -z "$TSX_ENTRY" ] || [ ! -f "$TSX_ENTRY" ]; then
  echo "$TOOL: cannot locate tsx in $ROOT/node_modules — run 'yarn install' there." >&2
  exit 2
fi
export TSX_TSCONFIG_PATH="$ROOT/tsconfig.json"

# ── 4. The corpus is the CALLER's, never the install's.
#
# A global tool that resolved `design/` against its own install would answer every
# project's question with ai-maestro's corpus — the "gate that passes because it read
# nothing" bug inverted into "a gate that read someone ELSE's corpus". When the caller
# names a corpus we pass their line through untouched; otherwise we point at THEIR
# $PWD/design and let the tool's own exit 2 fire if it does not exist.
#
# THE ONE PROPERTY THAT MAKES IT USEFUL ELSEWHERE: every `$TOOL.mjs` this launcher can
# invoke (trddgrep, and prrdgrep/specgrep via `runPillarCli`) resolves an absent
# `--design-dir` to `defaultDesignDirFor()` (lib/pillar/kinds.ts: `path.join(cwd, 'design')`)
# on its OWN, and this launcher does not `cd` and does not pass `--design-dir` itself. So
# the tool runs the CALLER's corpus, not ai-maestro's — with no bash literal here that could
# drift from the TS default (this launcher used to pass an explicit `$PWD/design`
# and rely on a comment to keep it in sync by hand; that duplicate is gone, not merely
# documented, because a duplicate a human must remember to update is the failure mode). If
# the shared default ever changes, this whole tool becomes one that silently reports
# ai-maestro's board to every project on the host — which is worse than not shipping it, so
# both are asserted in the test.

# ── 5. `fix`/`edit` are corpus-wide mutating verbs. Default them OFF outside this
# checkout (github.com/Emasoft/ai-maestro#161: two installers used to disagree on this,
# and one of them — the only one anything actually installed — had no gate at all).
#
# The janitor asked for exactly this split and it is right: a plain repo with no MANAGER
# and no approval chain should not get a mutating fixer by default, and `fix`/`edit` are
# the verbs that rewrite frontmatter across a whole corpus.
#
# It is a DEFAULT, not a security boundary, and the difference is stated so nobody
# mistakes it for one: anyone can still run the `.mjs` directly, and
# AIM_PILLAR_ALLOW_WRITE=1 lifts it on purpose. The hazard being prevented is an
# accidental corpus-wide rewrite in a project that never opted in, not an attacker.
#
# This gate covers only `fix`/`edit` — the two verbs already gated (differently, and one
# of them not at all) by the two installers this port replaces. `new set append check-box
# move` also mutate the corpus and are NOT gated here; scoping them is out of this port,
# tracked on ai-maestro#161.
#
# DO NOT try to find the verb by skipping each flag's value token: the pillar CLIs' flag
# sets differ and grow, so a wrapper enumerating "which flags take a value" gets it wrong
# by OMISSION, and an omitted flag shifts the verb and defeats the gate SILENTLY — the
# exact shape of bug this file exists to close (`--min-approval manager fix` bypassed an
# earlier draft this way). Fail closed instead: arm the gate whenever `fix` or `edit`
# appears as a standalone token anywhere in argv. This over-triggers on a contrived
# `--rule fix`, costing a spurious refusal whose own message already names the deliberate
# override — a far better trade than a silent hole.
case " $* " in *" fix "* | *" edit "*) mutating=1 ;; *) mutating=0 ;; esac

# Is the caller's cwd inside the ai-maestro checkout? Trailing slash on both sides so the
# root itself matches (a shell `*` matches the empty string). This is a cwd-PREFIX
# heuristic: a linked git worktree or a symlinked checkout compares as OUTSIDE and gets
# refused even though it is "the same" checkout in spirit — the safe direction, but it
# reads as the gate being broken rather than as the gate doing its job.
inside=0
case "$PWD/" in "$ROOT"/*) inside=1 ;; esac

if [ "$mutating" -eq 1 ] && [ "$inside" -eq 0 ] && [ "${AIM_PILLAR_ALLOW_WRITE:-}" != "1" ]; then
  echo "$TOOL: 'fix'/'edit' rewrite the corpus and are disabled outside the ai-maestro checkout." >&2
  echo "  The query surface (board, next, why, show, lint, validate, env) works here." >&2
  echo "  Deliberate? AIM_PILLAR_ALLOW_WRITE=1 $TOOL ..." >&2
  exit 2   # 2 = COULD NOT RUN, never 1 — 1 means 'found findings' for these CLIs.
fi

exec node --import "file://$TSX_ENTRY" "$ROOT/scripts/$TOOL.mjs" "$@"

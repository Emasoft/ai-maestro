{
  "scenariosDir": "tests/scenarios",
  "browserInstance": "ai-maestro-scenarios",
  "dashboardUrl": "http://localhost:23000/",
  "healthEndpoint": "http://localhost:23000/api/v1/health",
  "governancePasswordRef": "env:AIM_GOVERNANCE_PASSWORD",
  "helpersScript": "tests/scenarios/scripts/dev-browser-helpers/aim-helpers.sh",
  "writeGuardAllowlist": [],
  "typeCheckCommand": "npx tsc --noEmit",
